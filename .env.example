# --- Aplicación ---
APP_NAME=Fijazo Bets Service
# En true habilita /docs, /redoc y /openapi.json. Dejar en false en producción.
DEBUG=false
# Tamaño máximo (bytes) del body antes de responder 413. 2 MiB: aquí entran los .xlsx de
# importación, a diferencia del resto de servicios.
MAX_REQUEST_BODY_BYTES=2097152

# --- CORS ---
# En el destino final solo el api-gateway habla con este servicio y CORS deja de aplicar.
# Durante la migración el frontend puede seguir apuntando aquí directamente.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Opcional. Regex para orígenes dinámicos (p. ej. previews de Vercel).
# CORS_ORIGIN_REGEX=

# --- MongoDB ---
# Base propia del servicio: solo contiene apuestas. Los usuarios viven en users_db y las
# estadísticas en progression_db.
# En local (sin Docker) usa localhost; con el docker-compose de este repo, mongodb://mongo:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=bets_db
MONGO_MAX_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# --- Secreto de servicio a servicio ---
# Exigido en la cabecera X-Internal-Key de TODAS las rutas. Imprescindible: la identidad
# del usuario llega en X-User-Id, así que sin este secreto cualquiera que alcance el
# servicio podría operar en nombre de otro usuario.
# Debe ser el mismo valor que usan el api-gateway y auth-service (reparto: T-034).
# Sin este valor el servicio se niega a arrancar. Genéralo con: openssl rand -hex 32
INTERNAL_API_KEY=change-me-internal-service-secret

# --- users-service (validación del usuario, hop A->B) ---
# Con el host VACÍO se usa un validador permisivo que acepta a cualquier usuario: sirve
# para desarrollar sin users-service, pero NO debe desplegarse así.
# El cliente TCP real es la tarea T-017.
USERS_SERVICE_TCP_HOST=
USERS_SERVICE_TCP_PORT=3002
USERS_SERVICE_TIMEOUT_SECONDS=5.0

# --- Logging ---
# Nivel raíz de la app (DEBUG/INFO/WARNING/ERROR). Los logs salen en JSON por stdout.
LOG_LEVEL=INFO

# --- RabbitMQ (publisher real de eventos, T-027) ---
# Con la URL VACÍA se usa el publisher de log de desarrollo (eventos sólo en stdout): sirve
# para desarrollar sin RabbitMQ, pero NO debe desplegarse así.
RABBITMQ_URL=
BETS_EVENTS_EXCHANGE=bets.events

# --- Observabilidad (Sentry) ---
# DSN del proyecto de Sentry. Vacío = SDK deshabilitado (no rompe el arranque local).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
